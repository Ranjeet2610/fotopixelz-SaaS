DATABASE_URL="postgresql://postgres:password@localhost:5432/fotopixelz"
PORT=5000
NODE_ENV="development"

# Auth
JWT_ACCESS_SECRET="replace-me"
JWT_REFRESH_SECRET="replace-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Frontend URLs
WEB_APP_URL="http://localhost:3000"
ADMIN_APP_URL="http://localhost:3001"
API_BASE_URL="http://localhost:5000"

# Redis / queues
REDIS_URL="redis://localhost:6379"

# Payments
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# Object storage (S3 or R2)
STORAGE_PROVIDER="R2"
STORAGE_UPLOAD_EXPIRY_SECONDS="900"
STORAGE_DOWNLOAD_EXPIRY_SECONDS="300"

# AWS S3 (when STORAGE_PROVIDER=S3)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="fotopixelz"
# AWS_S3_ENDPOINT=""
# AWS_S3_PUBLIC_URL=""
STORAGE_PROVIDER=S3

# Cloudflare R2 (when STORAGE_PROVIDER=R2)
R2_ACCOUNT_ID="replace-me"
R2_ACCESS_KEY_ID="replace-me"
R2_SECRET_ACCESS_KEY="replace-me"
R2_BUCKET_NAME="fotopixelz"
# R2_PUBLIC_URL="https://cdn.example.com"

# Legacy upload/media (unused by storage module)
CLOUDINARY_CLOUD_NAME="replace-me"
CLOUDINARY_API_KEY="replace-me"
CLOUDINARY_API_SECRET="replace-me"

# Email
RESEND_API_KEY="re_replace_me"
LOG_LEVEL="info"
SENTRY_DSN=""

# Optional auth provider
CLERK_SECRET_KEY="sk_test_replace_me"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_replace_me"
